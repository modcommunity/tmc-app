<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI, compiled by `wixl` (msitools) rather than by WiX itself.

  Tauri's own MSI bundler shells out to WiX 3's candle.exe/light.exe and is
  therefore Windows-only; this file exists so a Windows installer can be
  produced from the Linux box the rest of the app is built on. `wixl` accepts a
  SUBSET of the WiX 3 schema — no MajorUpgrade, no util: extension, no
  WixUI dialogs — so everything here is written in the plain elements that
  subset covers. `scripts/make-msi.sh` substitutes the @TOKENS@.

  What it installs, and why each piece is here rather than left to the app:

    - TMC.exe into Program Files. One file: the binary is statically linked
      apart from the system webview.
    - A Start Menu shortcut, because a per-machine install puts the exe
      somewhere nobody browses to.
    - The `tmc://` scheme. The app cannot register this for itself on a
      per-machine install — HKLM needs elevation, and the installer is the one
      elevated moment there is. Without it every deep link in CLAUDE.md's table
      is dead on a Windows box.
  What it deliberately does NOT do is check for the Edge WebView2 runtime.
  Tauri's NSIS installer bootstraps it; wixl supports no launch conditions at
  all, so an MSI built here cannot even warn. Windows 11 ships the runtime and
  Windows 10 receives it with Edge, so the gap is narrow — but it is a real one,
  and it is why the .exe setup is the recommended download and the MSI is the
  one for people who have to deploy by policy.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="@PRODUCT@"
           Language="1033"
           Version="@VERSION@"
           Manufacturer="@PUBLISHER@"
           UpgradeCode="52AADA90-CF14-42C0-BD5D-B9337EC61C74">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Manufacturer="@PUBLISHER@"
             Description="@DESCRIPTION@" />

    <Media Id="1" Cabinet="tmc.cab" EmbedCab="yes" />

    <!-- Removing the old product AFTER InstallValidate is what makes this a
         major upgrade rather than two copies side by side. -->
    <Upgrade Id="52AADA90-CF14-42C0-BD5D-B9337EC61C74">
      <UpgradeVersion Minimum="0.0.0"
                      IncludeMinimum="yes"
                      Maximum="@VERSION@"
                      IncludeMaximum="yes"
                      Property="OLDVERSIONFOUND" />
    </Upgrade>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallValidate" />
    </InstallExecuteSequence>

    <Property Id="ARPPRODUCTICON" Value="tmc.ico" />
    <Property Id="ARPURLINFOABOUT" Value="@HOMEPAGE@" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Icon Id="tmc.ico" SourceFile="@ICON@" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="@PRODUCT@">

          <Component Id="MainExecutable" Guid="CCA5D944-EDD8-4331-A616-FF2E752AD7E9" Win64="yes">
            <File Id="TmcExe"
                  Name="@EXENAME@"
                  Source="@EXEPATH@"
                  KeyPath="yes" />
          </Component>

          <Component Id="DeepLinkScheme" Guid="3A03C91C-9034-4246-873D-CB727683729C" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\tmc"
                           Value="URL:@PRODUCT@ Protocol" Type="string" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="Software\Classes\tmc"
                           Name="URL Protocol" Value="" Type="string" />
            <RegistryValue Root="HKLM" Key="Software\Classes\tmc\DefaultIcon"
                           Value="&quot;[INSTALLDIR]@EXENAME@&quot;,0" Type="string" />
            <RegistryValue Root="HKLM" Key="Software\Classes\tmc\shell\open\command"
                           Value="&quot;[INSTALLDIR]@EXENAME@&quot; &quot;%1&quot;" Type="string" />
          </Component>

        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ShortcutDir" Name="@PUBLISHER@">
          <Component Id="StartMenuShortcut" Guid="88F94AD9-D530-4404-BF51-477A569A4E77">
            <Shortcut Id="TmcShortcut"
                      Name="@PRODUCT@"
                      Description="@DESCRIPTION@"
                      Target="[INSTALLDIR]@EXENAME@"
                      WorkingDirectory="INSTALLDIR"
                      Icon="tmc.ico" />
            <RemoveFolder Id="ShortcutDir" On="uninstall" />
            <!-- An HKCU value, because a shortcut is not a valid key path and
                 a component without one is a component Windows cannot repair. -->
            <RegistryValue Root="HKCU"
                           Key="Software\@PUBLISHER@\@PRODUCT@"
                           Name="installed" Value="1" Type="integer" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="@PRODUCT@" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="DeepLinkScheme" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Product>
</Wix>
